generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO      @map("todo")
  DOING     @map("doing")
  COMPLETED @map("completed")
  ON_HOLD  @map("on-hold")
  BACKLOG  @map("backlog")

  @@map("task_status")
}

enum TaskPriority {
  URGENT      @map("urgent")
  HIGH        @map("high")
  MEDIUM      @map("medium")
  LOW         @map("low")
  NO_PRIORITY @map("no-priority")

  @@map("task_priority")
}

model Task {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  status           TaskStatus    @default(TODO)
  priority         TaskPriority   @default(NO_PRIORITY)
  description      String?
  assigneeName     String?
  assigneeInitials String?
  startDate        DateTime?
  dueDate          DateTime?
  labels           String[]      @default([])
  teams            String[]      @default([])
  resources        String[]      @default([])
  reporterName     String?
  reporterAvatar   String?
  projectId        String?       @db.Uuid
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks         Subtask[]
  comments         TaskComment[]
  activities       TaskActivity[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([createdAt])
}

model Subtask {
  id               String       @id @default(uuid()) @db.Uuid
  taskId           String       @db.Uuid
  task             Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title            String
  priority         TaskPriority @default(NO_PRIORITY)
  assigneeName     String?
  assigneeInitials String?
  dueDate          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([taskId])
}

model TaskComment {
  id           String        @id @default(uuid()) @db.Uuid
  taskId       String        @db.Uuid
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId     String?       @db.Uuid
  parent       TaskComment?  @relation("TaskCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      TaskComment[] @relation("TaskCommentReplies")
  authorName   String
  authorEmail  String
  authorAvatar String?
  body         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([taskId, createdAt])
  @@index([parentId])
}

model TaskActivity {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorName   String
  actorAvatar String?
  type        String
  message     String
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}

model Project {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  priority  TaskPriority
  leadName  String?
  dueDate   DateTime?
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([createdAt])
}
